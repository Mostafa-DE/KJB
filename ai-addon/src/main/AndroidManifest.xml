<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The one way in: AiService below, bound only by an app holding this permission. Signature level: Android grants it,
         without asking, only to apps signed with this add-on's key, which is KJB's. KJB only uses it, so either can be
         installed first. The name carries the add-on's own id, so a debug and a release add-on never declare the same
         one. -->
    <permission
        android:name="${applicationId}.permission.BIND_AI"
        android:protectionLevel="signature" />

    <!-- The one-time model download (models/ModelDownloads), run while KJB keeps the add-on bound from its own
         foreground service, which shows the progress: the add-on runs no foreground service for it. It talks to
         Qualcomm AI Hub, GitHub and Hugging Face only (models/ModelStore.kt). The AI itself never goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A song's job runs in the add-on's own foreground service (ai/AiService.kt, JobForeground), which KJB starts for
         it: a phone's app freezer leaves alone an app at work in the foreground, not a service another app binds.
         mediaProcessing from Android 15 (long work on media files), dataSync before it. No notification permission: the
         add-on has no screen to ask from; without it its notice shows in the phone's list of apps at work only, and
         the service runs all the same. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Its own request to be left out of the phone's battery optimisation (ExemptionActivity in :addon-shared), which KJB
         offers when the add-on is set up: a phone's app freezer stopped an add-on at work with the screen locked, and
         left alone one that was exempt (phone session 10). Distributed outside Google Play. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- No launcher icon: the add-on shows only in Settings > Apps; its one activity has no window of its own.
         largeHeap: the engine streams a song's 44.1 kHz mix and vocals through the separation and keeps only the 16 kHz
         vocal stem, wav2vec2's emissions and the aligner's back-pointers (at most 64 MB): about 92 MB of Java heap at
         its peak for a 6-minute song, 156 MB for a 20-minute one (ai/LyricsFromAudio.kt, AiMemory). A song that would
         not fit the heap this gives is not started. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:ignore="DataExtractionRules">

        <!-- The QNN HTP backend reaches the phone's NPU (the Hexagon DSP) through FastRPC, the vendor public library
             libcdsprpc.so. Apps targeting Android 12+ get only the vendor public libraries they declare; without it the
             HTP device fails (QNN_DEVICE_ERROR_INVALID_CONFIG, the spike's phone run of 2026-11-13). Not required: a
             phone without it has no AI. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <!-- onnxruntime-android's ContentProvider that starts its 1DS telemetry client: removed, and telemetry is also
             switched off in code (ai/Npu.kt). -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <!-- KJB binds it by its explicit name while the AI works, the models download or its page shows, and starts it
             for the foreground while a song's job runs. Exported for KJB only: the signature permission above guards
             the bind and the start, every call checks the caller's uid and certificate, and a start is taken only with
             a PendingIntent KJB made (ai/AiService.kt). mediaProcessing is known from Android 15 (targetApi); below it
             the service goes into the foreground as dataSync. -->
        <service
            android:name=".AiService"
            android:exported="true"
            android:foregroundServiceType="mediaProcessing|dataSync"
            android:permission="${applicationId}.permission.BIND_AI"
            tools:targetApi="35" />

        <!-- Android's question to leave the add-on out of battery optimisation, for its own package, then back to KJB with
             the answer. Started by KJB only, for its result: the signature permission above, and the caller is checked
             again (ExemptionActivity). Translucent: Android's own dialog is all that shows. -->
        <activity
            android:name=".AiExemptionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="${applicationId}.permission.BIND_AI"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
