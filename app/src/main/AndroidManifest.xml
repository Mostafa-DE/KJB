<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- LRCLIB lookups carry artist, title, album and duration only. Covers & tags asks musicbrainz.org with album
         titles, artists, song titles, track counts and lengths, and gets covers from coverartarchive.org and the
         archive.org servers it redirects to. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- All files access: find songs in MediaStore and create .lrc files next to them in any
         folder. Granted by the user in Settings. KJB changes a song file only when the user confirms (Covers & tags),
         and only its tags and cover, never the music; every change can be undone. Songs leave only when the user
         moves them to the system trash (MediaStore.createTrashRequest, confirmed twice). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Tones: set a tone as the phone's ringtone, alarm or notification sound, only when the user taps Set. Granted by
         the user in "Modify system settings" (Settings.System.canWrite). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Tones, "Open Clock" after an alarm sound is set: clock apps open their alarm list (AlarmClock.ACTION_SHOW_ALARMS)
         only for apps holding SET_ALARM (AOSP DeskClock guards it so). A normal permission, granted at install. KJB
         never sets, changes or dismisses an alarm. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- The overnight AI lyrics run (overnight/AiWorker): a WorkManager worker in a foreground service of type
         mediaProcessing (Android 15+), at most 6 hours in 24. The one-time model download (models/ModelDownloadWorker):
         a WorkManager worker in a foreground service of type dataSync, also at most 6 hours in 24 from Android 15.
         WorkManager itself adds FOREGROUND_SERVICE, WAKE_LOCK, ACCESS_NETWORK_STATE (the models download on unmetered
         networks only) and RECEIVE_BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- player: permissions -->
    <!-- KJB's own player (player/PlaybackService): a foreground service of type mediaPlayback while music plays, as
         Android 14+ requires for media playback in the background (FOREGROUND_SERVICE itself is declared above). Its
         music notification needs no POST_NOTIFICATIONS: notifications of media sessions are exempt (Android 13+,
         developer.android.com, "Notification runtime permission", Exemptions). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The player keeps the CPU awake while it plays with the screen off (ExoPlayer's local wake mode). WorkManager
         adds it too. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- player: start when connected -->
    <!-- "Start when connected" (player/StartWhenConnected.kt), Android 13 and later: the Companion Device Manager tells KJB
         when a Bluetooth device the user picked in Android's picker connects (REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE),
         and that pairing lets KJB start its mediaPlayback service from the background
         (REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND, an exemption Android lists for companion apps). Both
         are normal permissions, granted at install with no prompt. Not REQUEST_COMPANION_RUN_IN_BACKGROUND, which would
         also lift battery limits, and not BLUETOOTH_CONNECT: the picker gives the device's name. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <!-- The pairing calls need this declared. Not required: a phone without it installs KJB and shows no row. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- lyrics lock: permissions -->
    <!-- "Display over other apps", for "Show when locked" only (ui/LockLyricsActivity): with it, Android lets KJB open
         the lyrics over the lock screen when the screen turns on while KJB plays. Asked only when the user switches it
         on, with a one-line reason; nothing is drawn over other apps. Tapping the music notification needs no
         permission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- androidx.core adds this one for dynamic receivers KJB never registers. -->
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- onnxruntime-android (the AI lyrics engine) adds ACCESS_NETWORK_STATE, INTERNET and a ContentProvider that
         starts its 1DS telemetry client. The provider is removed below and telemetry is also switched off in code
         (ai/Npu.kt). INTERNET stays for LRCLIB, Covers & tags (tags/lookup/MetaClient.kt: MusicBrainz
         and the Cover Art Archive only) and the one-time model download (models/ModelStore.kt: Qualcomm AI Hub,
         GitHub and Hugging Face only); ACCESS_NETWORK_STATE for that download's unmetered-network constraint. The AI
         itself never goes online. -->

    <!-- Package visibility (not a permission), for the name of the app whose media session KJB follows
         ("Playing in ..."), and for "Open Clock" below: reading sessions needs none. Players show up as apps with a launcher icon or a media
         browser service; KJB does not keep a list of players. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- Tones, "Open Clock" after an alarm sound is set: the app that shows the alarms, else Samsung Clock or Google
             Clock from its launcher entry (tones/ToneDefaults.kt). -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.google.android.deskclock" />
    </queries>

    <!-- largeHeap: the AI lyrics engine streams a song's 44.1 kHz mix and vocals through the separation and keeps only the
         16 kHz vocal stem, wav2vec2's emissions and the aligner's back-pointers (at most 64 MB): about 92 MB of Java heap at
         its peak for a 6-minute song, 156 MB for a 20-minute one (ai/LyricsFromAudio.kt, AiMemory). A song that would not
         fit the heap this gives is not started; the larger heap leaves room to spare. -->
    <application
        android:name=".LyrifyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lyrify">

        <!-- The QNN HTP backend reaches the phone's NPU (the Hexagon DSP) through FastRPC, the vendor public library
             libcdsprpc.so. Apps targeting Android 12+ get only the vendor public libraries they declare. Not required:
             a phone without it simply has no AI lyrics. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager's foreground service: mediaProcessing for the AI worker (long work on media files), dataSync for
             the model download. mediaProcessing is known from Android 15 (targetApi); neither worker runs on older
             versions. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing|dataSync"
            tools:node="merge"
            tools:targetApi="35" />

        <!-- Bound by the system while notification access is granted (sample manifest in the
             NotificationListenerService reference uses exported="false"). -->
        <service
            android:name=".media.NowPlayingListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- player -->
        <!-- KJB's own player: the media library service that holds the session (notification, lock screen, Bluetooth,
             headset buttons, Assistant) and the browse tree. Exported, as media controllers in other apps (Bluetooth,
             the system's media controls, Android Auto) bind it through these two actions. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Media3's receiver for media buttons when no player runs: Play on a headset or in the car after KJB was
             closed resumes the last queue (PlaybackService's playback resumption). -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Start when connected: bound by Android while a device paired with KJB is connected. Exported for the system,
             and only the system holds BIND_COMPANION_DEVICE_SERVICE (a signature permission), so no app can bind it.
             Android 13 and later (targetApi): before, KJB pairs with nothing, so Android never binds it. -->
        <service
            android:name=".player.ConnectService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="33">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- lyrics lock -->
        <!-- Lyrics over the lock screen (ui/LockLyricsActivity), shown without unlocking (showWhenLocked). A tap on the
             music notification opens the player with it on top, in KJB's task; on an unlocked phone it closes at once.
             "Show when locked" also starts it when the screen turns on while KJB plays, then as a task of its own,
             never in recents (excludeFromRecents counts for the task it starts), removed when it closes. Not exported:
             only KJB's own intents start it. -->
        <activity
            android:name=".ui.LockLyricsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true" />

        <!-- widget -->
        <!-- The home-screen widgets (widget/Widgets.kt): "KJB", 4 by 1, and "KJB large", 4 by 2. Glance receivers, exported
             because the home screen sends them its widget updates; their buttons reach the player through a
             MediaController, never a broadcast. -->
        <receiver
            android:name=".widget.SmallWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small" />
        </receiver>
        <receiver
            android:name=".widget.LargeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large" />
        </receiver>

        <!-- auto -->
        <!-- Android Auto: KJB is a media app, and the car browses and plays through PlaybackService above. An app installed
             from outside an app store shows in Android Auto only once its developer setting "Unknown sources" is on
             (Settings, About, "Using Android Auto"). The monochrome icon marks KJB's items in the car. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_stat_kjb" />
        <!-- Voice requests: Android Auto and the Assistant send "Play <words> on KJB" to the media session
             (auto/CarBrowse.kt). Some systems look for this older search intent to know KJB takes them; one sent this
             way only opens KJB. -->
        <activity-alias
            android:name=".auto.PlayFromSearch"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Covers for the car's lists (auto/CarBrowse.kt), by MediaStore id only, read-only. Not exported: the browse tree
             grants each app that browses it read access to the covers. -->
        <provider
            android:name=".auto.CarCovers"
            android:authorities="${applicationId}.covers"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
