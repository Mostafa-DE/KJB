<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- LRCLIB lookups carry artist, title, album and duration only. Covers & tags asks musicbrainz.org with album
         titles, artists, song titles, track counts and lengths, and gets covers from coverartarchive.org and the
         archive.org servers it redirects to. The update check asks api.github.com for KJB's latest release every hour
         while KJB is in front, and at once from Settings > About > Check for updates; Install downloads its APK from
         github.com. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- All files access: find songs in MediaStore and create .lrc files next to them in any
         folder, and save a cut of a song as a new file next to it. Granted by the user in Settings. KJB changes a song file only when the user confirms (Covers & tags),
         and only its tags and cover, never the music; every change can be undone. Songs leave only when the user
         moves them to the system trash (MediaStore.createTrashRequest, confirmed twice). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Tones: set a tone as the phone's ringtone, alarm or notification sound, only when the user taps Set. Granted by
         the user in "Modify system settings" (Settings.System.canWrite). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Tones, "Open Clock" after an alarm sound is set: clock apps open their alarm list (AlarmClock.ACTION_SHOW_ALARMS)
         only for apps holding SET_ALARM (AOSP DeskClock guards it so). A normal permission, granted at install. KJB
         never sets, changes or dismisses an alarm. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- The overnight AI lyrics run (overnight/AiWorker): a WorkManager worker in a foreground service of type
         mediaProcessing (Android 15+), at most 6 hours in 24, which keeps the AI add-on bound while it works. The
         models' download (addon/AddonDownload.kt): the add-on downloads them while KJB keeps it bound from a WorkManager
         worker in a foreground service of type dataSync (also 6 hours in 24 from Android 15), on unmetered networks only,
         and KJB shows its progress. WorkManager itself adds FOREGROUND_SERVICE, WAKE_LOCK, ACCESS_NETWORK_STATE and
         RECEIVE_BOOT_COMPLETED. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Notifications, Android 13 and later: only for the progress of the overnight AI worker, the models' download (KJB
         shows the add-on's download: the add-on posts nothing) and KJB's own downloads (downloads/), which without it
         show in the Task Manager only. Asked when the user switches the AI on, starts the models' download or the first
         download, never on the first run; after a lasting no, the AI screen has one row that opens the phone's
         notification settings. The music notification needs none (see the player's permissions). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ai add-on -->
    <!-- The AI runs in its own app, "KJB AI" (addon/): KJB binds its service through this signature permission, which
         only the add-on declares and Android grants only to apps signed with its key, KJB's. KJB checks the add-on's
         certificate before it binds, and the add-on checks KJB's on every call. -->
    <uses-permission android:name="${aiAddonPackage}.permission.BIND_AI" />
    <!-- Tools > AI lyrics > Get AI: KJB downloads the add-on from its GitHub release (pinned SHA-256, certificate checked)
         and installs it with Android's installer, after the user allows "Install unknown apps" for KJB and confirms. KJB's
         own update installs the same way (update/Updates.kt): the release's SHA-256, and KJB's own signing certificate. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: an update of the add-on KJB installed may go through without the confirm dialog (a normal
         permission; the first install always asks). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- downloads: permissions -->
    <!-- Downloads runs yt-dlp in its own add-on app, "KJB Downloads" (downloads/), bound through this signature
         permission, which only the add-on declares; the same checks both ways as the AI add-on. The add-on holds only
         INTERNET: KJB opens the file it saves into and writes its tags. KJB's own downloads service is a foreground
         service of type dataSync (FOREGROUND_SERVICE_DATA_SYNC above), with the progress and Cancel in its notification
         (POST_NOTIFICATIONS, asked on the first download). Getting the add-on uses the install permissions above. -->
    <uses-permission android:name="${dlAddonPackage}.permission.BIND_DL" />
    <!-- Whether a VPN is on (NetworkCapabilities.TRANSPORT_VPN): YouTube often refuses a VPN's address, so the Downloads
         page says so, and a failure says to turn it off. A normal permission; WorkManager's manifest asks for it too. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- player: permissions -->
    <!-- KJB's own player (player/PlaybackService): a foreground service of type mediaPlayback while music plays, as
         Android 14+ requires for media playback in the background (FOREGROUND_SERVICE itself is declared above). Its
         music notification needs no POST_NOTIFICATIONS: notifications of media sessions are exempt (Android 13+,
         developer.android.com, "Notification runtime permission", Exemptions). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The player keeps the CPU awake while it plays with the screen off (ExoPlayer's local wake mode). WorkManager
         adds it too. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- player: start when connected -->
    <!-- "Start when connected" (player/StartWhenConnected.kt), Android 13 and later: the Companion Device Manager tells KJB
         when a Bluetooth device the user picked in Android's picker connects (REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE),
         and that pairing lets KJB start its mediaPlayback service from the background
         (REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND, an exemption Android lists for companion apps). Both
         are normal permissions, granted at install with no prompt. Not REQUEST_COMPANION_RUN_IN_BACKGROUND, which would
         also lift battery limits, and not BLUETOOTH_CONNECT: the picker gives the device's name. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <!-- The pairing calls need this declared. Not required: a phone without it installs KJB and shows no row. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- lyrics lock: permissions -->
    <!-- "Display over other apps", for "Show when locked" only (ui/LockLyricsActivity): with it, Android lets KJB open
         the lyrics over the lock screen when the screen turns on while KJB plays. Asked only when the user switches it
         on, with a one-line reason; nothing is drawn over other apps. Tapping the music notification needs no
         permission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- androidx.core adds this one for dynamic receivers KJB never registers. -->
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- Package visibility (not a permission), for the name of the app whose media session KJB follows
         ("Playing in ..."), and for "Open Clock" below: reading sessions needs none. Players show up as apps with a launcher icon or a media
         browser service; KJB does not keep a list of players. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- Tones, "Open Clock" after an alarm sound is set: the app that shows the alarms, else Samsung Clock or Google
             Clock from its launcher entry (tones/ToneDefaults.kt). -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.google.android.deskclock" />
        <!-- The AI add-on: without it Android would show it to KJB as not installed, and refuse the bind. -->
        <package android:name="${aiAddonPackage}" />
        <!-- The Downloads add-on, for the same reason. -->
        <package android:name="${dlAddonPackage}" />
        <!-- KJB's own update (update/Updates.kt): the phone's package installer, whatever its name, so KJB can check that
             the install confirmation it starts is that installer's own. -->
        <intent>
            <action android:name="android.content.pm.action.CONFIRM_INSTALL" />
        </intent>
    </queries>

    <!-- largeHeap: was for the AI lyrics engine, which now runs in the AI add-on (its own process, its own large heap).
         Kept until a phone check shows KJB's own work (the library, covers) fits the ordinary heap. -->
    <application
        android:name=".LyrifyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lyrify">

        <!-- The theme (Settings > Display) is drawn by KJB: a change of the phone's or KJB's night mode reaches the page
             without the activity being made again (configChanges uiMode). -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:theme="@style/Theme.Lyrify.Main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- open files -->
            <!-- Audio files from other apps (ui/Launches.kt, player/OpenedFiles.kt): a file manager's View, and its Share of
                 one or several files; they play at once as one queue. content: addresses only, read through the opening
                 app's grant: never a file: path, which KJB would read with its own All files access. Audio only, so these
                 never take shared text: that is the Downloads add-on's "Save to KJB", through its own text/plain filter. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/flac" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/flac" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>
            <!-- huddle -->
            <!-- Huddle's invite links (huddle/Invites.kt, ui/Launches.kt): https on Huddle's Railway address
                 (app/build.gradle.kts), path /i, the invite's code after the # (a browser never sends it). Checked as KJB's
                 own (App Links): the host serves /.well-known/assetlinks.json with KJB's signing key. The user's own domain
                 (plan Q3.2) comes back here in 4.1, once it is live: on Android 11 one host that fails the check takes App
                 Links from every host in the manifest. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${huddleHost}" />
                <data android:path="/i" />
            </intent-filter>
            <!-- shortcuts -->
            <!-- The launcher's shortcuts, a long press on KJB's icon: Shuffle all, Resume, Search, Favourites. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- WorkManager's foreground service: mediaProcessing for the AI worker (long work on media files), known from
             Android 15 (targetApi); the worker does not run on older versions. dataSync for the models' download, which
             the add-on runs while KJB keeps it bound. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing|dataSync"
            tools:node="merge"
            tools:targetApi="35" />

        <!-- installs -->
        <!-- Android's installer reports every install KJB starts here (addon/AddonInstall.kt): KJB's own update
             (update/Updates.kt) and each add-on's, through KJB's own pending intents: not exported. -->
        <receiver
            android:name=".addon.InstallReceiver"
            android:exported="false" />

        <!-- downloads -->
        <!-- "Save to KJB" in other apps' share sheets (ui/SaveToKjbActivity): a small sheet over the sharing app for a
             shared link. Its own task, never in recents. Exported for the share sheet; it only reads the shared text's
             links and starts nothing without a tap. -->
        <activity
            android:name=".ui.SaveToKjbActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/dl_share_label"
            android:taskAffinity="${applicationId}.share"
            android:theme="@style/Theme.Lyrify.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- KJB's own downloads service (downloads/DownloadService.kt): dataSync, 6 hours in 24 from Android 15, with
             onTimeout handled. Started only while KJB is in front. Not exported. -->
        <service
            android:name=".downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- The notification's Cancel, through KJB's own pending intent: not exported. -->
        <receiver
            android:name=".downloads.DownloadCancelReceiver"
            android:exported="false" />

        <!-- tags -->
        <!-- Covers & tags' check (tags/CheckService.kt): dataSync while a check the user asked for looks albums up, so it
             goes on when they leave the page. Started only while KJB is in front, never again by itself. Not exported. -->
        <service
            android:name=".tags.CheckService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Bound by the system while notification access is granted (sample manifest in the
             NotificationListenerService reference uses exported="false"). -->
        <service
            android:name=".media.NowPlayingListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- player -->
        <!-- KJB's own player: the media library service that holds the session (notification, lock screen, Bluetooth,
             headset buttons, Assistant) and the browse tree. Exported, as media controllers in other apps (Bluetooth,
             the system's media controls, Android Auto) bind it through these two actions. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Media3's receiver for media buttons when no player runs: Play on a headset or in the car after KJB was
             closed resumes the last queue (PlaybackService's playback resumption). -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Start when connected: bound by Android while a device paired with KJB is connected. Exported for the system,
             and only the system holds BIND_COMPANION_DEVICE_SERVICE (a signature permission), so no app can bind it.
             Android 13 and later (targetApi): before, KJB pairs with nothing, so Android never binds it. -->
        <service
            android:name=".player.ConnectService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE"
            tools:targetApi="33">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- lyrics lock -->
        <!-- Lyrics over the lock screen (ui/LockLyricsActivity), shown without unlocking (showWhenLocked). A tap on the
             music notification opens the player with it on top, in KJB's task; on an unlocked phone it closes at once.
             "Show when locked" also starts it when the screen turns on while KJB plays, then as a task of its own,
             never in recents (excludeFromRecents counts for the task it starts), removed when it closes. Not exported:
             only KJB's own intents start it. -->
        <activity
            android:name=".ui.LockLyricsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true" />

        <!-- widget -->
        <!-- The home-screen widgets (widget/Widgets.kt): "KJB", 4 by 1, and "KJB large", 4 by 2. Glance receivers, exported
             because the home screen sends them its widget updates; their buttons reach the player through a
             MediaController, never a broadcast. -->
        <receiver
            android:name=".widget.SmallWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small" />
        </receiver>
        <receiver
            android:name=".widget.LargeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large" />
        </receiver>

        <!-- auto -->
        <!-- Android Auto: KJB is a media app, and the car browses and plays through PlaybackService above. An app installed
             from outside an app store shows in Android Auto only once its developer setting "Unknown sources" is on
             (README, "Using Android Auto"). The monochrome icon marks KJB's items in the car. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/ic_stat_kjb" />
        <!-- Voice requests: Android Auto and the Assistant send "Play <words> on KJB" to the media session
             (auto/CarBrowse.kt). Some systems look for this older search intent to know KJB takes them; one sent this
             way only opens KJB. -->
        <activity-alias
            android:name=".auto.PlayFromSearch"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Covers for Android Auto and the media session (auto/CarBrowse.kt, CarCovers): a song's embedded cover by
             MediaStore id only, or KJB's default cover; read-only. Exported, as Android Auto's own sample provider is: a
             grant given as a car connected could miss Android Auto (Media3 tells KJB of a controller that only listens
             at its first command, and each service start took grants back). Each uri carries its own signature
             (auto/CoverUris.kt), so only a uri KJB handed out opens, and none can be made. -->
        <provider
            android:name=".auto.CarCovers"
            android:authorities="${applicationId}.covers"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- share -->
        <!-- Share lyrics > Lyrics file (ui/Share.kt): the .lrc goes as a copy in KJB's cache, the one folder this provider
             serves (xml/share_paths.xml), typed by KJB, not by the phone's MimeTypeMap. Not exported: the app the user
             picks in the share sheet may read that one file. Songs go as MediaStore's own content URIs and need no
             provider. -->
        <provider
            android:name=".ui.ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- WorkManager starts on its first use (LyrifyApplication is its Configuration.Provider), off the main thread
             when that is the similar artists' schedule, instead of on the main thread before every process start's
             first line of KJB (PW1). The other initializers stay. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
