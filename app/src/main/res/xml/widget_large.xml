<?xml version="1.0" encoding="utf-8"?>
<!-- "KJB large", the large home-screen widget (widget/Widgets.kt), 4 by 2. Drawn by Glance and updated only when the
     playback service pushes a change, never on a timer (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_large_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_preview_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
