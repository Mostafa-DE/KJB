<?xml version="1.0" encoding="utf-8"?>
<!-- "KJB", the small home-screen widget (widget/Widgets.kt), 4 by 1. Drawn by Glance and updated only when the playback
     service pushes a change, never on a timer (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_small_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_preview_small"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
