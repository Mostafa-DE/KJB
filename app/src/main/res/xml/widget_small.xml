<?xml version="1.0" encoding="utf-8"?>
<!-- "KJB", the Glow widget placed at 4 by 1 (widget/Widgets.kt): the song on its own blurred cover. Resized taller it
     draws the medium and large layouts, as "KJB large" does. Drawn by Glance and updated only when the playback service
     pushes a change, never on a timer (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_small_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_preview_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
