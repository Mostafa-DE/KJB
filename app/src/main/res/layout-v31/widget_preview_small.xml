<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's picture of "KJB" (Android 12 and later, which reads previewLayout): the Glow widget's small
     layout on KJB's default cover, its glow drawn as a soft light, white words and buttons: the cover, the name, then
     Previous, Play and Next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_glow"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    tools:ignore="Overdraw">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_preview_cover"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/kjb_default_cover" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_skip_previous_fill"
        android:tint="#FFFFFFFF" />

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginHorizontal="2dp"
        android:background="@drawable/widget_preview_play"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/ic_play_arrow_fill"
        android:tint="#FF1A1426" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_skip_next_fill"
        android:tint="#FFFFFFFF" />
</LinearLayout>
