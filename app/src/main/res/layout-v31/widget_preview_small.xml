<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's picture of "KJB" (Android 12 and later, which reads previewLayout), in the wallpaper's colours:
     the K on its black tile, the name, Play and Next. The home screen paints no background of its own behind it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/system_accent2_50"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    tools:ignore="Overdraw">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/black"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/ic_brand_k" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@android:color/system_neutral1_900"
        android:textSize="15sp" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_play_arrow_fill"
        android:tint="@android:color/system_accent1_600" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_skip_next_fill"
        android:tint="@android:color/system_neutral1_900" />
</LinearLayout>
