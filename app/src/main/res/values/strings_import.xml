<!-- Import from another app (lane IM1, ui/ImportScreens.kt): Settings, Backup, Import from app. Labels are three words or fewer; sentences only in the sheet. -->
<resources>
    <string name="import_row">Import from app</string>
    <string name="import_row_detail">Playlists from other players</string>

    <!-- The first sheet: where the files come from. -->
    <string name="import_title">Import from app</string>
    <string name="import_intro">Pick the files another player exported, or the folder that holds them. KJB reads m3u, m3u8, pls and xspf files, and only ever adds to what you have.</string>
    <string name="import_pick_file">Pick file</string>
    <string name="import_pick_folder">Pick folder</string>
    <string name="import_phone_title">On your phone</string>
    <plurals name="import_phone_text">
        <item quantity="one">%1$s playlist other apps saved on your phone.</item>
        <item quantity="other">%1$s playlists other apps saved on your phone.</item>
    </plurals>
    <string name="import_phone_button">From your phone</string>
    <string name="import_where_title">Other players</string>
    <string name="import_where_samsung">Samsung Music: Settings, Manage playlists, Export my playlists. Then pick the file in your Music folder.</string>
    <string name="import_where_poweramp">Poweramp: Settings, Folders and Library, Export Poweramp Playlists. Then pick the folder they went to.</string>
    <string name="import_where_musicolet">Musicolet: export each playlist as an M3U file, then pick them. Its own backups can\'t be read yet.</string>
    <string name="import_where_aimp">AIMP: export the playlist as an XSPF file, then pick it.</string>
    <string name="import_where_others">Other players: export your playlists as m3u, pls or xspf files. Their favourites and play counts stay in the other app, as these files don\'t hold them.</string>
    <string name="import_reading">Reading</string>

    <!-- The preview. -->
    <string name="import_found_file">Found in file</string>
    <string name="import_found_files">Found in files</string>
    <string name="import_found_folder">Found in folder</string>
    <string name="import_found_phone">On your phone</string>
