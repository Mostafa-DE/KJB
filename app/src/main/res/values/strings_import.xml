    <string name="import_not_found_text">They aren\'t on your phone, so they\'re left out.</string>
    <string name="import_more">And %1$s more</string>
    <string name="import_merge">A playlist with a name you already have gets only the songs it doesn\'t hold yet, at its end. Favourites are added and play counts only go up. Nothing is removed or replaced.</string>
    <string name="import_now">Import now</string>
    <string name="import_cancel">Cancel</string>

