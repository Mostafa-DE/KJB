<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lyrify" parent="android:Theme.Material.NoActionBar" />

    <!-- A sheet's window: no arrival of its own (the sheet slides itself), and an exit for when it is closed in code. -->
    <style name="SheetWindow">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
